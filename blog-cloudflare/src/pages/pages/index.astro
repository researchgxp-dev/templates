---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Archive from "../../components/Archive.astro";
import { PAGE_CACHE } from "../../utils/cache";
import { ui } from "../../utils/ui";

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries, nextCursor, cacheHint } = await getEmDashCollection("pages", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 15,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set({ ...cacheHint, ...PAGE_CACHE });
---

<Base title={ui.pages.title} description={ui.pages.description}>
	<Archive
		title={ui.pages.title}
		posts={entries}
		collection="pages"
		nextCursor={nextCursor}
		empty={ui.pages.empty}
		olderLabel={ui.pages.older}
	/>
</Base>
